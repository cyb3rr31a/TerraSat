

# --- Meta Model API (SAM 3.1, Muse Spark, voice)
# Key from https://dev.meta.ai -> API keys
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# --- Mapbox satellite imagery
# Token from https://account.mapbox.com/access-tokens
MAPBOX_TOKEN=
# mapbox_static (default, Static Images API) | mapbox (Raster Tiles API) | esri (no key, dev fallback)
TILE_PROVIDER=mapbox_static

# --- Google Places (optional) - competitors for business questions (Places API (New), Text Search)
# Key from https://console.cloud.google.com/google/maps-apis (enable "Places API (New)"; needs billing)
GOOGLE_MAPS_API_KEY=

# --- Baseten - fallback only (e.g. Whisper if Swahili transcription is weak, issue #9)
# Key from https://app.baseten.co -> Settings -> API keys
BASETEN_API_KEY=

# Modal does NOT go here: run `modal setup` once and the Modal CLI stores its own token.

# --- Access control (needed before the API gets a public address)
# Make keys with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# API_KEY: the apps send it with every request (web: VITE_API_KEY in web/.env; phone: Settings -> Advanced).
# It keeps strangers out, but it ships inside the apps, so it isn't a password. Leave empty for local development.
API_KEY=
# STAFF_KEY: needed to list everyone's reports and change their status. Never put it in the apps.
STAFF_KEY=
# Limits (defaults shown)
# ASK_PER_MINUTE=10
# ASK_PER_DAY=100
# REPORTS_PER_MINUTE=5
# REPORTS_PER_DAY=50
# GOOGLE_CALLS_PER_DAY=300
# MAX_AUDIO_MB=10
# MAX_PHOTO_MB=5
